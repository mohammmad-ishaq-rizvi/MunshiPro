# Optional Gemma 4 via Gemini API.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional automatic due reminders: approved WhatsApp utility template body
# placeholders {{1}}..{{4}} = customer, amount, due date, UPI payment URI.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_IN

# Optional direct WhatsApp PDF delivery: approved document-header template.
WHATSAPP_SUMMARY_TEMPLATE_NAME=
WHATSAPP_SUMMARY_TEMPLATE_LANGUAGE=en_IN

# Optional database location; defaults to ./dukaan.sqlite3.
DUKAAN_DB_PATH=
